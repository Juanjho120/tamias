# TAMIAS dual-environment configuration reference
# Do NOT commit real secrets.
#
# Environments:
# - Testing / Portfolio: https://tamias.juantzun.dev
# - Production real:     https://tamias-prod.juantzun.dev
#
# Recommended infrastructure:
# - Two Vercel projects
# - Two Render services
# - Two Supabase databases/projects
# - Two S3 buckets
# - Two Chroma instances or isolated Chroma collections
#
# Both environments can deploy from main.
# Keep data and secrets isolated per environment.

# ============================================================
# SHARED BACKEND VARIABLE NAMES
# ============================================================
# These names should exist in both Render services.
# Values must be different between Testing and Production.

SPRING_PROFILES_ACTIVE=prod
PORT=8080

DATABASE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
DATABASE_USERNAME=<database-username>
DATABASE_PASSWORD=<database-password>

JWT_SECRET=<long-random-secret-64-plus-characters>
JWT_EXPIRATION_MINUTES=60

CORS_ALLOWED_ORIGINS=https://<frontend-domain>

AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_REGION=us-east-2
AWS_S3_BUCKET=<bucket-name>
S3_PRESIGNED_URL_EXPIRATION_SECONDS=300

OPENAI_API_KEY=<openai-api-key>
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.2

CHROMA_HOST=<chroma-host-without-port>
CHROMA_PORT=8000
CHROMA_BASE_URL=https://<chroma-url>
CHROMA_COLLECTION_NAME=<chroma-collection-name>

AI_DEFAULT_TOP_K=10
AI_DEFAULT_SIMILARITY_THRESHOLD=0.30

MAX_FILE_SIZE=8MB
MAX_REQUEST_SIZE=8MB

# ============================================================
# TESTING / PORTFOLIO ENVIRONMENT EXAMPLE
# ============================================================
# Frontend:
#   Vercel project: tamias-testing
#   Domain:         https://tamias.juantzun.dev
#
# Backend:
#   Render service: tamias-api-testing
#   Backend URL:    https://tamias-api-testing.onrender.com/api/v1
#
# Database:
#   Supabase:       tamias-testing
#
# Files:
#   S3 bucket:      tamias-testing-files
#
# Chroma:
#   Collection:     tamias_testing_documents

TESTING_FRONTEND_URL=https://tamias.juantzun.dev
TESTING_BACKEND_API_URL=https://tamias-api-testing.onrender.com/api/v1
TESTING_CORS_ALLOWED_ORIGINS=https://tamias.juantzun.dev
TESTING_AWS_S3_BUCKET=tamias-testing-files
TESTING_CHROMA_COLLECTION_NAME=tamias_testing_documents

# ============================================================
# PRODUCTION REAL ENVIRONMENT EXAMPLE
# ============================================================
# Frontend:
#   Vercel project: tamias-production
#   Domain:         https://tamias-prod.juantzun.dev
#
# Backend:
#   Render service: tamias-api-prod
#   Backend URL:    https://tamias-api-prod.onrender.com/api/v1
#
# Database:
#   Supabase:       tamias-production
#
# Files:
#   S3 bucket:      tamias-prod-files
#
# Chroma:
#   Collection:     tamias_prod_documents

PROD_FRONTEND_URL=https://tamias-prod.juantzun.dev
PROD_BACKEND_API_URL=https://tamias-api-prod.onrender.com/api/v1
PROD_CORS_ALLOWED_ORIGINS=https://tamias-prod.juantzun.dev
PROD_AWS_S3_BUCKET=tamias-prod-files
PROD_CHROMA_COLLECTION_NAME=tamias_prod_documents

# ============================================================
# FRONTEND BUILD NOTE
# ============================================================
# Angular environment.prod.ts is build-time.
# For two Vercel projects using the same main branch, configure each
# project with its own frontend API URL strategy in a later block:
#
# Option A:
#   Generate frontend/src/environments/environment.prod.ts during build
#   from a Vercel environment variable such as FRONTEND_API_BASE_URL.
#
# Option B:
#   Use runtime configuration loaded from /assets/config.json.
#
# Recommended for TAMIAS:
#   Option A for MVP simplicity.
#
# Vercel project env var examples:
#   Testing project:
#     FRONTEND_API_BASE_URL=https://tamias-api-testing.onrender.com/api/v1
#
#   Production project:
#     FRONTEND_API_BASE_URL=https://tamias-api-prod.onrender.com/api/v1
