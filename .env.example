# TAMIAS production-like environment variables
# Copy this file to your hosting provider environment settings.
# Do NOT commit real secrets.

# ------------------------------------------------------------
# Backend runtime
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# ------------------------------------------------------------
# PostgreSQL / Supabase
# DATABASE_URL must be a JDBC URL, not a postgres:// URL.
# Example:
# DATABASE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# ------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://<supabase-host>:5432/<database-name>?sslmode=require
DATABASE_USERNAME=<database-username>
DATABASE_PASSWORD=<database-password>

# ------------------------------------------------------------
# JWT
# Use a long random value. Recommended: 64+ characters.
# ------------------------------------------------------------
JWT_SECRET=<replace-with-long-random-secret>
JWT_EXPIRATION_MINUTES=60

# ------------------------------------------------------------
# CORS
# Frontend production URL.
# Add Vercel preview URLs only when needed.
# ------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://tamias.juantzun.dev,https://<your-vercel-project>.vercel.app

# ------------------------------------------------------------
# AWS S3
# Bucket should be private. Access should happen through backend-generated URLs.
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_REGION=us-east-2
AWS_S3_BUCKET=tamias-prod-files
S3_PRESIGNED_URL_EXPIRATION_SECONDS=300

# ------------------------------------------------------------
# OpenAI
# ------------------------------------------------------------
OPENAI_API_KEY=<openai-api-key>
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.2

# ------------------------------------------------------------
# Chroma / Railway
# CHROMA_HOST must not include the port.
# CHROMA_BASE_URL must include protocol and port/path when required.
# ------------------------------------------------------------
CHROMA_HOST=<railway-chroma-host>
CHROMA_PORT=8000
CHROMA_BASE_URL=https://<railway-chroma-url>
CHROMA_COLLECTION_NAME=tamias_documents

# ------------------------------------------------------------
# AI defaults
# ------------------------------------------------------------
AI_DEFAULT_TOP_K=10
AI_DEFAULT_SIMILARITY_THRESHOLD=0.30

# ------------------------------------------------------------
# Upload limits
# ------------------------------------------------------------
MAX_FILE_SIZE=8MB
MAX_REQUEST_SIZE=8MB

# ------------------------------------------------------------
# Frontend production build
# Angular production API base URL is currently configured in:
# frontend/src/environments/environment.prod.ts
# ------------------------------------------------------------
FRONTEND_PROD_API_BASE_URL=https://tamias-api.onrender.com/api/v1
