# TAMIAS Render environment variables — Production real
# Service name: tamias-api-prod
# Frontend domain: https://tamias-prod.juantzun.dev
# Backend target: https://tamias-api-prod.onrender.com
#
# Copy these names into Render.
# Replace placeholder values in Render only.
# Do not commit real secrets.

SPRING_PROFILES_ACTIVE=prod
PORT=8080

DATABASE_URL=jdbc:postgresql://<production-supabase-host>:5432/<production-database>?sslmode=require
DATABASE_USERNAME=<production-database-username>
DATABASE_PASSWORD=<production-database-password>

JWT_SECRET=<production-long-random-secret-64-plus-characters>
JWT_EXPIRATION_MINUTES=60

CORS_ALLOWED_ORIGINS=https://tamias-prod.juantzun.dev

AWS_ACCESS_KEY_ID=<production-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<production-aws-secret-access-key>
AWS_REGION=us-east-2
AWS_S3_BUCKET=tamias-prod-files
S3_PRESIGNED_URL_EXPIRATION_SECONDS=300

OPENAI_API_KEY=<openai-api-key>
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.2

# Spring AI Chroma client.
# Must include protocol and must not include port.
CHROMA_HOST=https://<production-chroma-host-without-port>
CHROMA_PORT=8000

# TAMIAS custom Chroma integration.
# Full base URL, include protocol and port/path when required.
CHROMA_BASE_URL=https://<production-chroma-url>
CHROMA_COLLECTION_NAME=tamias_prod_documents

AI_DEFAULT_TOP_K=10
AI_DEFAULT_SIMILARITY_THRESHOLD=0.30

MAX_FILE_SIZE=8MB
MAX_REQUEST_SIZE=8MB
