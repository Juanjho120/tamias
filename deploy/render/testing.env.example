# TAMIAS Render environment variables — Testing / Portfolio
# Service name: tamias-api-testing
# Frontend domain: https://tamias.juantzun.dev
# Backend target: https://tamias-api-testing.onrender.com
#
# Copy these names into Render.
# Replace placeholder values in Render only.
# Do not commit real secrets.

SPRING_PROFILES_ACTIVE=prod
PORT=8080

DATABASE_URL=jdbc:postgresql://<testing-supabase-host>:5432/<testing-database>?sslmode=require
DATABASE_USERNAME=<testing-database-username>
DATABASE_PASSWORD=<testing-database-password>

JWT_SECRET=<testing-long-random-secret-64-plus-characters>
JWT_EXPIRATION_MINUTES=60

CORS_ALLOWED_ORIGINS=https://tamias.juantzun.dev

AWS_ACCESS_KEY_ID=<testing-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<testing-aws-secret-access-key>
AWS_REGION=us-east-2
AWS_S3_BUCKET=tamias-testing-files
S3_PRESIGNED_URL_EXPIRATION_SECONDS=300

OPENAI_API_KEY=<openai-api-key>
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.2

# Spring AI Chroma client.
# Must include protocol and must not include port.
CHROMA_HOST=https://<testing-chroma-host-without-port>
CHROMA_PORT=8000

# TAMIAS custom Chroma integration.
# Full base URL, include protocol and port/path when required.
CHROMA_BASE_URL=https://<testing-chroma-url>
CHROMA_COLLECTION_NAME=tamias_testing_documents

AI_DEFAULT_TOP_K=10
AI_DEFAULT_SIMILARITY_THRESHOLD=0.30

MAX_FILE_SIZE=8MB
MAX_REQUEST_SIZE=8MB
