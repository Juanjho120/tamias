     private String joinName(Object firstName, Object lastName) {
         return (value(firstName) + " " + value(lastName)).trim();
     }
+
+    private boolean containsAnySimple(String value, String... candidates) {
+        for (String candidate : candidates) {
+            if (value.contains(normalizeQuestion(candidate))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private String normalizeQuestion(String value) {
+        if (value == null) {
+            return "";
+        }
+        return value
+            .toLowerCase()
+            .replace("á", "a")
+            .replace("é", "e")
+            .replace("í", "i")
+            .replace("ó", "o")
+            .replace("ú", "u")
+            .replace("ü", "u")
+            .replace("ñ", "n")
+            .replace("¿", " ")
+            .replace("?", " ")
+            .replaceAll("\\s+", " ")
+            .trim();
+    }
 
